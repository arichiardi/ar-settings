# ik_llama.cpp - Qwen3.8-Flash-Next, ji-farthing v3 IQ3_KT + MTP draft head
#
# Model card: https://huggingface.co/ji-farthing/Qwen3.8-Flash-Next-ik-llama-GGUF
#
# Hardware target: one RTX 4060 (8 GiB VRAM), 62 GiB RAM, 44 cores.
#
# This variant adds the 2.21 GiB MTP head. MTP costs VRAM, not RAM, so the
# model quant is unchanged. The context is halved to 16384 to make room.
#
# The MTP head is the same file for every main quant; it stays IQ4_KT.
#
# Download:
#   hfdownloader download ji-farthing/Qwen3.8-Flash-Next-ik-llama-GGUF \
#     -F 'IQ3_KT,MTP' -E 'imatrix' \
#     --local-dir /var/lib/llm/models/ik_llama
#
# Start:  ik_llama-start qwen3.8-flash-next-mtp
# Stop:   ik_llama-stop  qwen3.8-flash-next-mtp

GGML_CUDA_NO_PINNED=1

LLAMA_LOG_COLORS=1
LLAMA_ARG_ENDPOINT_METRICS=1

# VRAM budget: 4.5 GiB non-expert tensors + 2.21 GiB MTP head + about 0.3 GiB
# KV at 16K + about 0.5 GiB compute = about 7.5 GiB of 8 GiB. If it runs out of
# memory, lower -ngl (40, then 32), or lower -c to 8192.
#
# The head carries its own hyper-connection mixer. --spec-type mtp:n_max=1 is
# the card's setting. If the head still does not fit, append the card's
# fallback, which gives the head its own small batch:
#   -draft "-ub 256 -b 256"
#
# Cache types ik_llama accepts: f32 f16 bf16 q8_0 q4_0 q4_1 iq4_nl q5_0 q5_1
# q6_0 q8_KV. There is no q3 type. iq4_nl or q4_1 are the smallest.
LLAMA_ARGS=--host 0.0.0.0 --port 11434 --alias Qwen3.8-Flash-Next-MTP --model /var/lib/llm/models/ik_llama/ji-farthing/Qwen3.8-Flash-Next-ik-llama-GGUF/Qwen3.8-Flash-Next-ik_llama-v3-IQ3_KT-00001-of-00002.gguf --defer-ple -ngl 49 -ot ffn_.*_exps=CPU -fa on -ctk q6_0 -ctv q6_0 -ictk q8_0 --jinja -c 16384 -b 2048 -ub 512 --ctx-checkpoints 16 -t 22 -tb 22 --no-mmap -sm graph -rtr --spec-type mtp:n_max=1,p_min=0.0 -md /var/lib/llm/models/ik_llama/ji-farthing/Qwen3.8-Flash-Next-ik-llama-GGUF/Qwen3.8-Flash-Next-MTP-ik_llama-IQ4_KT.gguf
