#!/usr/bin/env bash
#
# Initialize sway within this system.
#
# The scripts has to be run from the ar-settings repository.
#
set -euo pipefail

# For skipping sections, use this trick:
#
#   cat >/dev/null <<LABEL
#
# see the brilliant answer here: https://stackoverflow.com/a/45538151

source ./usr/local/bin/ar-helpers.sh

echo_info "Installing sway and related packages"

# wlroots is released as versioned packages (wlroots0.20, ...) - there is no
# stable 'wlroots' name, so resolve the one the current sway depends on.
# Query with the base manager (pacman, not yay). The field is 'Depends On:'
# in recent pacman (localized variants start with 'Depends' as well).
pkg_detect || true
wlroots_pkg=$(pkg_run -q -m "$pkg_mgr_base" -Si sway 2> /dev/null \
    | sed -n 's/^Depends[^:]*: *//p' | tr ' ' '\n' | grep -m1 '^wlroots' || true)

# wlr-protocols is required by conky's native Wayland backend: it ships
# wlr-layer-shell-unstable-v1.xml, which conky loads at runtime to create a
# layer-shell surface. Without it conky silently falls back to the X11/
# Xwayland backend and gets tiled as a normal window by sway.
# polkit-gnome is the polkit authentication agent KeePassXC Quick Unlock needs.
# sway does not autostart a polkit agent, so Quick Unlock fails with "No Polkit
# authentication agent was available" without one.
#
# Use polkit-gnome (a GTK agent that runs under XWayland), not hyprpolkitagent.
# hyprpolkitagent is a Wayland client on the hyprtoolkit/aquamarine renderer,
# which needs a GBM allocator with PRIME buffer export. This box has 2x NVIDIA
# RTX 3090 + an AMD Raphael iGPU. The agent auto-selects the lowest PCI GPU (the
# NVIDIA GA102), whose proprietary userspace GBM has no PRIME export, so it
# aborts on init with "Couldn't open a gbm fd". nvidia-open is only the kernel
# module; the GBM/PRIME gap is userspace. Env knobs AQ_RENDER_DEVICE
# (compositor-only) and __EGL_VENDOR_LIBRARY_FILENAMES=50_mesa.json (device
# enumeration still lists NVIDIA first) do not help; the client has no device
# index knob. polkit-gnome runs under XWayland and needs no GBM. It is the polkit
# reference agent and is in the official extra repo, not AUR.
#
# The agent is started from home/.config/sway/config.
sway_packages=(sway swaybg swayidle waybar wlogout \
               swaylock-effects \
               grim slur brightnessctl wl-clipboard \
               dunst rofi foot conky wlr-protocols pcmanfm-gtk3 flameshot wev \
               xdg-desktop-portal-gtk \
               keepassxc accountsservice \
               polkit-gnome \
               ttf-jetbrains-mono ttf-noto-nerd \
               lightdm-gtk-greeter lightdm onboard \
               librsvg)
if [[ $wlroots_pkg ]]; then
    sway_packages=(sway "$wlroots_pkg" "${sway_packages[@]:1}")
else
    echo_warn "Could not resolve the wlroots package from sway's dependencies - sway will pull it in itself"
fi

pkg_install "${sway_packages[@]}"
