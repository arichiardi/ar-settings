# Whole-file OpenPGP: show decrypted text in diffs and merge through
# gpg-merge. Driver definitions live in git config, not in the repository.
*.gpg diff=gpg merge=gpg

# The caddy configs are GPG symmetric (passphrase, no recipient), written by
# gpg-backup-to-repo. gpg-merge re-encrypts with GIT_GPGMERGE_KEY, which would
# turn them into public-key files and break the loopback/symmetric decrypt.
etc/caddy/Caddyfile.gpg diff=gpg -merge
etc/caddy/conf.d/*.gpg diff=gpg -merge
etc/caddy/conf.d/**/*.gpg diff=gpg -merge

# The pi agent config is GPG symmetric (passphrase, no recipient), written by
# gpg-backup-to-repo. Disable the merge driver: gpg-merge re-encrypts with
# GIT_GPGMERGE_KEY, which turns a symmetric file into a public-key file and
# breaks the symmetric decrypt loop.
home/.config/pi/agent/*.gpg diff=gpg -merge

# Exported secret-key backups are binary OpenPGP packets, not ciphertext.
bootstrap/gpg/*.gpg binary
