#!/bin/sh
# pinentry-dispatch - route gpg-agent pinentry requests to the right backend.
#
# gpg-agent launches this script (configured via `pinentry-program`) for
# every passphrase prompt. The calling application hints at its environment
# through PINENTRY_USER_DATA, a GnuPG-defined variable.
#
# Hints understood (set by the application before invoking gpg):
#   PINENTRY_USER_DATA=emacs   -> pinentry-emacs   (Emacs minibuffer)
#   PINENTRY_USER_DATA=curses  -> pinentry-curses  (terminal UIs, pass)
#   PINENTRY_USER_DATA=gtk     -> pinentry-gtk     (TUIs on a desktop, e.g. pi)
#   PINENTRY_USER_DATA=mac     -> pinentry-mac     (macOS native dialog)
#   PINENTRY_USER_DATA=qt      -> pinentry-qt
#
# No hint: use pinentry-mac when installed, else the graphical pinentry
# when a display is available, else pinentry-tty on a bare console.
#
# NOTE: pinentry-emacs only works while an Emacs with pinentry mode is
# running; if the hint is set but the program fails, the user must retry
# without the hint.

# Trace every routing decision so a broken hint or missing binary is
# visible. gpg-agent runs with stderr on the tty that started it.
_dispatch_log () { printf 'pinentry-dispatch: %s\n' "$*" >&2; }

case "${PINENTRY_USER_DATA:-}" in
    emacs)
        exec /usr/bin/pinentry-emacs "$@"
        ;;
    curses)
        exec /usr/bin/pinentry-curses "$@"
        ;;
    gtk)
        _dispatch_log "hint=gtk DISPLAY=${DISPLAY:-} WAYLAND=${WAYLAND_DISPLAY:-}"
        exec /usr/bin/pinentry-gtk "$@"
        ;;
    mac)
        if [ -x /opt/homebrew/bin/pinentry-mac ]; then
            _dispatch_log "hint=mac backend=pinentry-mac"
            exec /opt/homebrew/bin/pinentry-mac "$@"
        fi
        _dispatch_log "hint=mac but pinentry-mac not found, falling back to tty"
        exec /usr/bin/pinentry-tty "$@"
        ;;
    qt)
        exec /usr/bin/pinentry-qt "$@"
        ;;
    *)
        if [ -x /opt/homebrew/bin/pinentry-mac ]; then
            _dispatch_log "no hint, backend=pinentry-mac"
            exec /opt/homebrew/bin/pinentry-mac "$@"
        fi
        if [ -n "${DISPLAY:-}" ]; then
            _dispatch_log "no hint, x display available"
            exec /usr/bin/pinentry-gtk "$@"
        fi
        _dispatch_log "no hint and no x display, using tty"
        exec /usr/bin/pinentry-tty "$@"
        ;;
esac
