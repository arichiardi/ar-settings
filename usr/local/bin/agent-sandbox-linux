#!/usr/bin/env bash
# agent-sandbox-linux - run a command inside a bubblewrap sandbox.
#
# Env vars:
#   SANDBOX_AGENT_ENV_WHITELIST    - space-delimited list of env var names passed into the sandbox.
#   SANDBOX_AGENT_DIR_RW_WHITELIST - space-delimited list of host paths (files or dirs) bind-mounted RW.
#   SANDBOX_AGENT_DIR_RO_WHITELIST - space-delimited list of host paths (files or dirs) bind-mounted RO.
#   SANDBOX_AGENT_DIR_TMPFS_BINDS  - space-delimited list of host directories replaced by an
#                                    empty mode-0700 tmpfs. The RO/RW/socket lists then bind
#                                    selected paths back into the tmpfs.
#   SANDBOX_AGENT_SOCKET_WHITELIST - space-delimited list of host unix sockets bind-mounted RW.
#   SANDBOX_AGENT_PRIMARY_GROUP    - one group NAME. Sets the sandbox primary group through
#                                    bwrap --gid. A numeric GID is refused: it can name wheel.
#                                    Unset grants no real group (nobody, gid 65534).
#   SANDBOX_AGENT_GROUP_UNSAFE     - set to 1 to allow 'root' or 'wheel' as primary group.
set -euo pipefail

# Read from environment, default to empty.
SANDBOX_AGENT_ENV_WHITELIST="${SANDBOX_AGENT_ENV_WHITELIST:-}"
SANDBOX_AGENT_DIR_RW_WHITELIST="${SANDBOX_AGENT_DIR_RW_WHITELIST:-}"
SANDBOX_AGENT_DIR_RO_WHITELIST="${SANDBOX_AGENT_DIR_RO_WHITELIST:-}"
SANDBOX_AGENT_DIR_TMPFS_BINDS="${SANDBOX_AGENT_DIR_TMPFS_BINDS:-}"
SANDBOX_AGENT_SOCKET_WHITELIST="${SANDBOX_AGENT_SOCKET_WHITELIST:-}"
SANDBOX_AGENT_PRIMARY_GROUP="${SANDBOX_AGENT_PRIMARY_GROUP:-}"
SANDBOX_AGENT_GROUP_UNSAFE="${SANDBOX_AGENT_GROUP_UNSAFE:-}"

echo_info() { echo "ℹ️ $*"; }
echo_warn() { echo "⚠️ $*" >&2; }
echo_error() { echo "❌ $*" >&2; }

if ! command -v bwrap >/dev/null 2>&1; then
    echo_error "bwrap not found. Install bubblewrap." >&2
    exit 1
fi

if [[ $EUID -eq 0 ]]; then
    echo_error "This script must not be run as root."
    exit 1
fi

bwrap_args=(
    --unshare-uts
    --unshare-cgroup
    --share-net
    --tmpfs /tmp
    --tmpfs /run
    --dir /run/user
    --bind "/run/user/$(id -u)" "/run/user/$(id -u)"
    --dev-bind /dev /dev
    --proc /proc
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind "$HOME" "$HOME"
    --dir /var
    --symlink ../tmp var/tmp
    --perms 0700 --tmpfs /etc
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --die-with-parent
    --ro-bind-data 11 /etc/passwd
    --ro-bind-data 12 /etc/group
)

# Drop supplementary groups (e.g. wheel). The caller identity is mapped
# through an unprivileged user namespace, so this works as non-root.
bwrap_args+=( --unshare-user )

# Choose the primary group. Accept a group name only, never a numeric GID: a number such as
# 998 names wheel on this host and bypasses the block below. bwrap rejects non-numeric gids,
# so resolve the name here. bwrap calls setgid with --gid and denies setgroups, so
# supplementary groups stay dropped.
_sandbox_gid=""
if [[ -n "$SANDBOX_AGENT_PRIMARY_GROUP" ]]; then
    group="$SANDBOX_AGENT_PRIMARY_GROUP"
    if [[ "$group" =~ ^[0-9]+$ ]]; then
        echo_error "Refusing numeric GID: $group. Use a group name, so 'wheel' stays blocked."
        exit 1
    fi
    # Block privileged names before lookup. getent sees no groups in a nested sandbox, and
    # the caller's kernel group set excludes wheel (see /proc/self/status Groups), so an
    # unresolvable name would otherwise fall through to gid 65534 and grant it.
    if [[ "$group" == "root" || "$group" == "wheel" ]] && [[ "$SANDBOX_AGENT_GROUP_UNSAFE" != "1" ]]; then
        echo_error "Refusing group: $group. Set SANDBOX_AGENT_GROUP_UNSAFE=1 to allow it."
        exit 1
    fi
    gid="$(getent group "$group" | cut -d: -f3 || true)"
    if [[ ! -n "$gid" ]]; then
        # Warn and keep going: getent sees no groups inside a nested sandbox, so this check
        # cannot tell a missing group from a starved /etc/group. A bad value must not exit.
        echo_warn "Group skipped: $group. It resolves to no gid; the sandbox gets no real group."
    else
        _sandbox_gid="$gid"
    fi
fi

# Unset grants no real group, so a login group such as wheel is never used by accident.
if [[ ! -n "$_sandbox_gid" ]]; then
    _sandbox_gid=65534
fi

bwrap_args+=( --gid "$_sandbox_gid" )

# Whitelist entries are literal paths; globs are expanded in the profile
# (07-sandbox.bash). Disable pathname expansion for the loops below.
set -f

# Tmpfs mounts first: the tmpfs hides the host contents of the directory and
# gives a writable, mode-0700 root. The RW, socket, and RO binds below then
# expose only the selected paths inside the tmpfs.
for dir in $SANDBOX_AGENT_DIR_TMPFS_BINDS; do
    if [[ -d "$dir" ]]; then
        bwrap_args+=( --perms 0700 --tmpfs "$dir" )
    else
        echo_warn "Tmpfs skipped: $dir does not exist"
    fi
done

for path in $SANDBOX_AGENT_DIR_RW_WHITELIST; do
    if [[ -e "$path" ]]; then
        bwrap_args+=( --bind "$path" "$path" )
    else
        echo_warn "RW bind skipped: $path does not exist"
    fi
done

# Unix sockets always need a read-write bind so the host daemons stay
# reachable. bwrap binds them with --bind, like a path.
for socket in $SANDBOX_AGENT_SOCKET_WHITELIST; do
    if [[ -S "$socket" ]]; then
        bwrap_args+=( --bind "$socket" "$socket" )
    else
        echo_warn "Socket bind skipped: $socket does not exist"
    fi
done


# RO binds. A read-only bind area is recursive: --ro-bind forces every bind
# under it read-only. So an RO path that is an ancestor of an RW path must not
# be a recursive ro area, or it swallows the rw child (EROFS, notably on ZFS
# where /opt, /opt/llm and /opt/polystrata share one dataset superblock).
# Bind such a parent rw, then re-bind each rw child on top of it, then
# remount the parent read-only non-recursively. The child binds sit above the
# parent mount, so the parent's --remount-ro (non-recursive) leaves them rw.
for path in $SANDBOX_AGENT_DIR_RO_WHITELIST; do
    if [[ ! -e "$path" ]]; then
        echo_warn "RO bind skipped: $path does not exist"
        continue
    fi
    rw_children=()
    for rw in $SANDBOX_AGENT_DIR_RW_WHITELIST; do
        case "$rw" in "$path"/*) rw_children+=( "$rw" ) ;; esac
    done
    if [[ "${#rw_children[@]}" -gt 0 ]]; then
        bwrap_args+=( --bind "$path" "$path" )
        for child in "${rw_children[@]}"; do
            bwrap_args+=( --bind "$child" "$child" )
        done
        bwrap_args+=( --remount-ro "$path" )
    else
        bwrap_args+=( --ro-bind "$path" "$path" )
    fi
done

# The synthetic /etc is generated in the sandbox; the host /etc is never
# bound. Remount it read-only so a write to /etc fails loudly instead of
# silently vanishing into the tmpfs. --remount-ro does not recurse, so the
# explicit binds above stay mounted. Any file that must be writable needs
# an explicit RW bind, added before this line.
bwrap_args+=( --remount-ro /etc )

for var in $SANDBOX_AGENT_ENV_WHITELIST; do
    if [[ -n "${!var:-}" ]]; then
        bwrap_args+=( "--setenv" "$var" "${!var}" )
    fi
done

set +f

echo_info "Sandbox env: $SANDBOX_AGENT_ENV_WHITELIST"

GIT_TERMINAL_PROMPT=${GIT_TERMINAL_PROMPT:-0}

_user="${USER:-$(id -un)}"
_grp="$(id -gn)"
_pw="${_user}:x:$(id -u):$(id -g):${_user}:${HOME}:${SHELL:-/bin/bash}
nobody:x:65534:65534:nobody:/nonexistent:/usr/bin/nologin"
_gr="${_grp}:x:$(id -g):
nobody:x:65534:"

if [[ $# -eq 0 ]]; then
    echo_error "Usage: $0 <command> [args...]" >&2
    exit 1
fi

cmd=$1; shift

bwrap "${bwrap_args[@]}" -- "$cmd" "$@" \
    11< <(printf '%s\n' "$_pw") \
    12< <(printf '%s\n' "$_gr")
