#!/usr/bin/env bash
# agent-sandbox-linux - run a command inside a bubblewrap sandbox.
#
# Env vars:
#   SANDBOX_AGENT_ENV_WHITELIST    - space-delimited list of env var names passed into the sandbox.
#   SANDBOX_AGENT_DIR_RW_WHITELIST - space-delimited list of host paths (files or dirs) bind-mounted RW.
#   SANDBOX_AGENT_DIR_RO_WHITELIST - space-delimited list of host paths (files or dirs) bind-mounted RO.
#   SANDBOX_AGENT_DIR_TMPFS_BINDS  - space-delimited list of host directories replaced by an
#                                    empty mode-0700 tmpfs. The RO/RW/socket lists then bind
#                                    selected paths back into the tmpfs.
#   SANDBOX_AGENT_SOCKET_WHITELIST - space-delimited list of host unix sockets bind-mounted RW.
set -euo pipefail

# Read from environment, default to empty.
SANDBOX_AGENT_ENV_WHITELIST="${SANDBOX_AGENT_ENV_WHITELIST:-}"
SANDBOX_AGENT_DIR_RW_WHITELIST="${SANDBOX_AGENT_DIR_RW_WHITELIST:-}"
SANDBOX_AGENT_DIR_RO_WHITELIST="${SANDBOX_AGENT_DIR_RO_WHITELIST:-}"
SANDBOX_AGENT_DIR_TMPFS_BINDS="${SANDBOX_AGENT_DIR_TMPFS_BINDS:-}"
SANDBOX_AGENT_SOCKET_WHITELIST="${SANDBOX_AGENT_SOCKET_WHITELIST:-}"

echo_info() { echo "ℹ️ $*"; }
echo_warn() { echo "⚠️ $*" >&2; }
echo_error() { echo "❌ $*" >&2; }

if ! command -v bwrap >/dev/null 2>&1; then
    echo_error "bwrap not found. Install bubblewrap." >&2
    exit 1
fi

bwrap_args=(
    --unshare-uts
    --unshare-cgroup
    --share-net
    --tmpfs /tmp
    --tmpfs /run
    --dir /run/user
    --bind "/run/user/$(id -u)" "/run/user/$(id -u)"
    --dev-bind /dev /dev
    --proc /proc
    --ro-bind /usr /usr
    --ro-bind /bin /bin
    --ro-bind /lib /lib
    --ro-bind /lib64 /lib64
    --ro-bind "$HOME" "$HOME"
    --dir /var
    --symlink ../tmp var/tmp
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --die-with-parent
    --dir /etc
    --bind-data 11 /etc/passwd
    --bind-data 12 /etc/group
)

# Drop supplementary groups (e.g. wheel)
if [[ $EUID -ne 0 ]]; then
    bwrap_args+=( --unshare-user )
fi

# Whitelist entries are literal paths; globs are expanded in the profile
# (07-sandbox.bash). Disable pathname expansion for the loops below.
set -f

# Tmpfs mounts first: the tmpfs hides the host contents of the directory and
# gives a writable, mode-0700 root. The RW, socket, and RO binds below then
# expose only the selected paths inside the tmpfs.
for dir in $SANDBOX_AGENT_DIR_TMPFS_BINDS; do
    if [[ -d "$dir" ]]; then
        bwrap_args+=( --perms 0700 --tmpfs "$dir" )
    else
        echo_warn "Tmpfs skipped: $dir does not exist"
    fi
done

for path in $SANDBOX_AGENT_DIR_RW_WHITELIST; do
    if [[ -e "$path" ]]; then
        bwrap_args+=( --bind "$path" "$path" )
    else
        echo_warn "RW bind skipped: $path does not exist"
    fi
done

# Unix sockets always need a read-write bind so the host daemons stay
# reachable. bwrap binds them with --bind, like a path.
for socket in $SANDBOX_AGENT_SOCKET_WHITELIST; do
    if [[ -S "$socket" ]]; then
        bwrap_args+=( --bind "$socket" "$socket" )
    else
        echo_warn "Socket bind skipped: $socket does not exist"
    fi
done


for path in $SANDBOX_AGENT_DIR_RO_WHITELIST; do
    if [[ -e "$path" ]]; then
        bwrap_args+=( --ro-bind "$path" "$path" )
    else
        echo_warn "RO bind skipped: $path does not exist"
    fi
done

for var in $SANDBOX_AGENT_ENV_WHITELIST; do
    if [[ -n "${!var:-}" ]]; then
        bwrap_args+=( "--setenv" "$var" "${!var}" )
    fi
done

set +f

echo_info "Sandbox env: $SANDBOX_AGENT_ENV_WHITELIST"

GIT_TERMINAL_PROMPT=${GIT_TERMINAL_PROMPT:-0}

if [[ $EUID -ne 0 ]]; then
    # Inside uid 0 is the host user
    _pw="${USER}:x:0:0:${USER}:${HOME}:${SHELL:-/bin/bash}
nobody:x:65534:65534:nobody:/home:/usr/bin/nologin"
    _gr="${USER}:x:0:
nobody:x:65534:"
else
    _pw="root:x:0:0:root:/root:/bin/bash
${USER}:x:${UID}:${UID}::${HOME}:${SHELL:-/bin/bash}
nobody:x:65534:65534:nobody:/home:/usr/bin/nologin"
    _gr="root:x:0:
${USER}:x:${UID}:
nobody:x:65534:"
fi

cmd=$1; shift

bwrap "${bwrap_args[@]}" -- "$cmd" "$@" \
    11< <(printf '%s\n' "$_pw") \
    12< <(printf '%s\n' "$_gr")
