#!/usr/bin/env bash
#
# Encrypt live machine files into the repository as <repo_path>.gpg
# siblings. The plaintext never touches the repo tree: it is streamed
# straight from the source path into gpg.
#
# Each entry is "machine_path:repo_path". A file is re-encrypted only
# when the live file is newer than its committed ciphertext.
#
# Pass one or more full paths to restrict the run. A path matches the
# machine path or the repo path of an entry. With no argument the script
# updates every entry. Examples:
#
#   ./gpg-backup-to-repo                    # all entries
#   ./gpg-backup-to-repo home/.config/pi/agent/models.json
#
# The script has to be run from the ar-settings repository root.
#
set -euo pipefail

source ./usr/local/bin/ar-helpers.sh
source ./home/.local/bin/gpg-helpers.sh

all_files=(
    "/etc/caddy/Caddyfile:etc/caddy/Caddyfile"
    "/etc/caddy/conf.d/alba.conf:etc/caddy/conf.d/alba.conf"
    "/etc/caddy/conf.d/alba/ai-api-handler.caddy:etc/caddy/conf.d/alba/ai-api-handler.caddy"
    "/etc/caddy/conf.d/alba/llamacpp_handler.caddy:etc/caddy/conf.d/alba/llamacpp_handler.caddy"
    "/etc/caddy/conf.d/alba/llamaswap_handler.caddy:etc/caddy/conf.d/alba/llamaswap_handler.caddy"
)

if [[ $# -gt 0 ]]; then
    selected=()
    for want in "$@"; do
        found=
        for entry in "${all_files[@]}"; do
            src=${entry%%:*}
            dest=${entry#*:}
            if [[ "$want" == "$src" || "$want" == "$dest" ]]; then
                selected+=("$entry")
                found=1
                break
            fi
        done
        if [[ -z "$found" ]]; then
            echo_fail "No entry matches: $want"
            echo_info "Known entries:"
            printf '  %s\n' "${all_files[@]}"
            exit 1
        fi
    done
else
    selected=("${all_files[@]}")
fi

for entry in "${selected[@]}"; do
    src=${entry%%:*}
    dest=${entry#*:}

    if [[ ! -f "$src" ]]; then
        echo_warn "Missing, skipping: $src"
        continue
    fi

    if [[ -f "$dest.gpg" && ! "$src" -nt "$dest.gpg" ]]; then
        echo_info "Unmodified: $dest.gpg"
        continue
    fi

    echo_info "Encrypting: $dest.gpg"
    mkdir -p "$(dirname "$dest.gpg")"
    if [[ -r "$src" ]]; then
        gpg --yes $gpg_symmetric_args --symmetric --out "$dest.gpg" "$src"
    else
        echo_warn "Not readable, piping through sudo: $src"
        sudo -v
        sudo cat "$src" | gpg --yes $gpg_symmetric_args --symmetric --out "$dest.gpg"
    fi

    echo_info "Verifying: $dest.gpg"
    gpg --quiet --yes $gpg_symmetric_args --decrypt --output /dev/null "$dest.gpg"
done
