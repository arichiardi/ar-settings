#!/usr/bin/env bash
#
# Encrypt live machine files into the repository as <repo_path>.gpg
# siblings. The plaintext never touches the repo tree: it is streamed
# straight from the source path into gpg.
#
# Each entry is "machine_path:repo_path". A file is re-encrypted only
# when its ciphertext does not decrypt to the live plaintext. Content,
# not mtime, decides. A git checkout restamps a ciphertext with the
# current time, so an mtime check hides a stale snapshot forever.
#
# Pass one or more full live paths to restrict the run. With no argument
# the script updates every entry. Examples:
#
#   ./gpg-backup-to-repo                    # all entries
#   ./gpg-backup-to-repo ~/.config/pi/agent/models.json
#   ./gpg-backup-to-repo /etc/caddy/Caddyfile
#
# The script has to be run from the ar-settings repository root.
#
set -euo pipefail

source ./usr/local/bin/ar-helpers.sh
source ./home/.local/bin/gpg-helpers.sh

all_files=(
    "/etc/caddy/Caddyfile:etc/caddy/Caddyfile"
    "/etc/caddy/conf.d/alba.conf:etc/caddy/conf.d/alba.conf"
    "/etc/caddy/conf.d/alba/ai-api-handler.caddy:etc/caddy/conf.d/alba/ai-api-handler.caddy"
    "/etc/caddy/conf.d/alba/llamaswap_handler.caddy:etc/caddy/conf.d/alba/llamaswap_handler.caddy"
    "$HOME/.config/pi/agent/models.json:home/.config/pi/agent/models.json"
    "$HOME/.config/pi/agent/settings.json:home/.config/pi/agent/settings.json"
    "$HOME/.config/pi/agent/ar-llm/handoff.json:home/.config/pi/agent/ar-llm/handoff.json"
    "$HOME/.config/pi/agent/ar-llm/custom-compaction.json:home/.config/pi/agent/ar-llm/custom-compaction.json"
    "$HOME/.config/pi/agent/ar-llm/dir-providers.json:home/.config/pi/agent/ar-llm/dir-providers.json"
)

if [[ $# -gt 0 ]]; then
    selected=()
    for want in "$@"; do
        found=
        for entry in "${all_files[@]}"; do
            src=${entry%%:*}
            if [[ "$want" == "$src" ]]; then
                selected+=("$entry")
                found=1
                break
            fi
        done
        if [[ -z "$found" ]]; then
            echo_fail "No entry matches: $want"
            echo_info "Known entries:"
            printf '  %s\n' "${all_files[@]}"
            exit 1
        fi
    done
else
    selected=("${all_files[@]}")
fi

# Echo the live plaintext to stdout. Escalate with sudo when the file is
# not readable by the caller.
function read_src() {
    if [[ -r "$1" ]]; then
        cat "$1"
    else
        sudo -v
        sudo cat "$1"
    fi
}

# Return 0 when "$1" decrypts to exactly the plaintext of "$2". The
# plaintext travels through a pipe into cmp. Never write it to disk. Keep
# gpg stderr, which carries diagnostics and no key material, in $gpg_err
# so the caller can report the reason.
function content_matches() {
    gpg --quiet --yes $gpg_symmetric_args --decrypt "$1" 2>"$gpg_err" \
        | cmp -s - <(read_src "$2")
}

# The temp file holds gpg stderr only. shred -u zeroizes, truncates, and
# unlinks it in one step.
gpg_err=$(mktemp --tmpdir gpg-backup-verify.XXXXXX)
trap 'shred -u "$gpg_err"' EXIT

for entry in "${selected[@]}"; do
    src=${entry%%:*}
    dest=${entry#*:}

    if [[ ! -f "$src" ]]; then
        echo_warn "Missing, skipping: $src"
        continue
    fi

    reason=missing
    if [[ -f "$dest.gpg" ]]; then
        if content_matches "$dest.gpg" "$src"; then
            echo_info "Unmodified: $dest.gpg"
            continue
        fi
        reason="ciphertext does not match live content"
        echo_warn "$dest.gpg: $reason"
        while read -r line; do echo_info "  ${line#gpg: }"; done < "$gpg_err"
        confirm "Re-encrypt $dest.gpg from $src?"
    fi

    echo_info "Encrypting: $dest.gpg ($reason)"
    mkdir -p "$(dirname "$dest.gpg")"
    if [[ -r "$src" ]]; then
        gpg --yes $gpg_symmetric_args --symmetric --out "$dest.gpg" "$src"
    else
        echo_warn "Not readable, piping through sudo: $src"
        sudo -v
        sudo cat "$src" | gpg --yes $gpg_symmetric_args --symmetric --out "$dest.gpg"
    fi

    echo_info "Verifying: $dest.gpg"
    if ! content_matches "$dest.gpg" "$src"; then
        echo_fail "Verify failed: $dest.gpg does not decrypt to $src"
        cat "$gpg_err" >&2
        exit 1
    fi
    echo_ok "Verified: $dest.gpg"
done
