{
  "lastChangelogVersion": "1.1.0",
  "defaultProvider": "github-copilot",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "low",
  "hideThinkingBlock": true,
  "tuiMode": "regular",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32768,
    "keepRecentTokens": 65536
  },
  "enabledModels": [
    "claude-opus-*",
    "claude-sonnet-*",
    "deepseek/deepseek-v4.1-*",
    "google/gemma-4*",
    "gpt*",
    "liquid/*",
    "LFM2.5*",
    "kimi-k3",
    "mai-code-1.1*",
    "poolside/laguna-*",
    "qwen/qwen3.*-122b*",
    "qwen/qwen3.*-27b*",
    "qwen/qwen3.8*",
    "qwen3.*"
  ],
  "packages": [
    "npm:pi-subagents",
    "npm:pi-intercom",
    "npm:@ar-llm/pi-custom-compaction",
    "npm:pi-prompt-template-model",
    "npm:pi-rewind",
    "npm:@ar-llm/pi-dir-providers",
    "npm:@ar-llm/pi-plan-mode",
    "npm:@ar-llm/pi-handoff",
    "npm:pi-token-speed"
  ],
  "subagents": {
    "agentOverridesByProvider": {
      "github-copilot": {
        "oracle": {
          "model": "github-copilot/gpt-5.6-terra",
          "thinking": "high"
        },
        "planner": {
          "model": "github-copilot/gpt-5.6-sol",
          "thinking": "medium"
        },
        "reviewer": {
          "model": "github-copilot/gpt-5.6-luna",
          "thinking": "high"
        },
        "worker": {
          "model": "github-copilot/gpt-5.6-luna"
        },
        "explorer": {
          "model": "github-copilot/mai-code-1.1-flash"
        },
        "scout": {
          "model": "github-copilot/mai-code-1.1-flash"
        }
      },
      "openrouter": {
        "oracle": {
          "model": "tencent/hy4-preview",
          "thinking": "high"
        },
        "planner": {
          "model": "tencent/hy4-preview",
          "thinking": "medium"
        },
        "reviewer": {
          "model": "inception/mercury-2.5-preview"
        },
        "worker": {
          "model": "qwen/qwen3.8-flash"
        },
        "explorer": {
          "model": "poolside/laguna-s-2.1:free"
        },
        "scout": {
          "model": "poolside/laguna-s-2.1:free"
        }
      },
      "llama.cpp": {
        "oracle": {
          "model": "Qwen3.8-27B-Swift-MTP",
          "thinking": "xhigh"
        },
        "planner": {
          "model": "Qwen3.8-27B-Swift-MTP",
          "thinking": "xhigh"
        },
        "reviewer": {
          "model": "Qwen3.8-27B-Swift-MTP",
          "thinking": "medium"
        },
        "worker": {
          "model": "Qwen3.8-27B-Swift-MTP",
          "thinking": "low"
        },
        "explorer": {
          "model": "LFM2.5-VL-3B"
        },
        "scout": {
          "model": "LFM2.5-VL-3B"
        }
      }
    }
  },
  "theme": "dark"
}
