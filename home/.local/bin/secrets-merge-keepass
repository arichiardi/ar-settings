#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_name=$(basename "$script_path")
script_dir=$(dirname "$script_path")

do_usage() {
    echo "Usage:"
    echo "  $script_name --dest <dest_dir> --src <source_dir> [--ui]"
    echo "Merge Keepass databases from a source dir into a destination dir."
    echo "With --ui, open differing databases in KeepassXC for manual merge."
    exit "${1:-0}"
}

launch_keepassxc() {
    local db_path="$1"
    local lock_file="/tmp/keepassxc-$(whoami).lock"
    local existing_pid=""

    # Try to get PID from lockfile
    if [[ -f "$lock_file" ]]; then
        existing_pid=$(head -1 "$lock_file" 2>/dev/null)
        # Verify PID is actually running
        if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
            echo "existing:$existing_pid"
            return 0
        fi
    fi

    # No running instance - launch new one
    keepassxc "$db_path" </dev/null 2>/dev/null &
    echo "new:$!"
}

dest_dir=
src_dir=
ui_mode=no

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dest) dest_dir="$2"; shift 2 ;;
        --src)  src_dir="$2"; shift 2 ;;
        --ui)   ui_mode=yes; shift ;;
        -h|--help) do_usage 0 ;;
        *) echo "Unknown option: $1"; do_usage 1 ;;
    esac
done

if [[ -z "$dest_dir" ]]; then
    echo "--dest is required"
    do_usage 1
fi
if [[ -z "$src_dir" ]]; then
    echo "--src is required"
    do_usage 1
fi

declare -a dest_paths
while IFS= read -r -d '' file_name; do
    dest_paths+=( "$file_name" )
done < <(find "$dest_dir" -maxdepth 1 -name '*.kdbx' -print0)

for dest_path in "${dest_paths[@]}"; do
    dest_name=$(basename "$dest_path")
    source_path="$src_dir/$dest_name"

    if [[ -f "$dest_path" && -f "$source_path" ]]; then
        if [[ "$(sha256sum "$dest_path")" != "$(sha256sum "$source_path")" ]]; then
            echo "Differing database: $dest_name"
            echo "  dest: $dest_path"
            echo "  src:  $source_path"
            echo "─────────────────────────────────────────"

            if [[ "$ui_mode" == "yes" ]]; then
                kp_result=$(launch_keepassxc "$dest_path")
                kp_type="${kp_result%%:*}"
                kp_pid="${kp_result#*:}"
                if [[ "$kp_type" == "new" ]]; then
                    wait "$kp_pid" 2>/dev/null || true
                else
                    read -r -p "Press Enter when done... "
                fi
            else
                set +e
                keepassxc-cli merge --same-credentials "$dest_path" "$source_path"
                set -e
            fi
        else
            echo "Database $dest_path had not been changed, skipping..."
        fi
    else
        echo "Either destination ($dest_path) or source ($source_path) did not exist, skipping..."
    fi
done
