#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_name=$(basename "$script_path")
script_dir=$(dirname "$script_path")

do_usage() {
    echo "Usage:"
    echo "  $script_name --key-id <id> --key <key> --bucket <bucket> --dest <target_dir> [--ui]"
    echo ""
    echo "Download Keepass databases from Backblaze B2 and merge them locally."
    echo "With --ui, open differing databases in KeepassXC for manual merge."
    exit "${1:-0}"
}

cleanup_after_error() {
    rm -rf "$1"
    exit 1
}

key_id=
key=
bucket=
target_dir=
ui_mode=no

while [[ $# -gt 0 ]]; do
    case "$1" in
        --key-id) key_id="$2"; shift 2 ;;
        --key)    key="$2"; shift 2 ;;
        --bucket) bucket="$2"; shift 2 ;;
        --dest)   target_dir="$2"; shift 2 ;;
        --ui)     ui_mode=yes; shift ;;
        -h|--help) do_usage 0 ;;
        *) echo "Unknown option: $1"; do_usage 1 ;;
    esac
done

if [[ -z "$key_id" ]]; then
    echo "--key-id is required"
    do_usage 1
fi
if [[ -z "$key" ]]; then
    echo "--key is required"
    do_usage 1
fi
if [[ -z "$bucket" ]]; then
    echo "--bucket is required"
    do_usage 1
fi
if [[ -z "$target_dir" ]]; then
    echo "--dest is required"
    do_usage 1
fi

tmp_dir=$(mktemp -d -t "b2-secrets-XXXXX")

if [[ ! -d "$tmp_dir" ]]; then
    echo "Could not create temp dir"
    exit 1
fi

trap "cleanup_after_error '$tmp_dir'" SIGINT SIGHUP SIGPIPE SIGQUIT SIGTERM

env B2_APPLICATION_KEY_ID="$key_id" B2_APPLICATION_KEY="$key" \
  b2-wrapper sync \
    --replace-newer \
    --include-regex "(.*\.kdbx)" \
    --exclude-regex "(.*)" \
    --exclude-all-symlinks \
    "b2://$bucket" "$tmp_dir"

"$script_dir/secrets-merge-keepass" --dest "$target_dir" --src "$tmp_dir" ${ui_mode:+--ui}

rm -rf "$tmp_dir"
