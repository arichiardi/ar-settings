#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_name=$(basename "$script_path")
script_dir=$(dirname "$script_path")

do_usage() {
    echo "Usage:"
    echo "  $script_name --remote <rclone_remote_path> --dest <target_dir> [--ui]"
    echo ""
    echo "Download Keepass databases from an rclone remote and merge them locally."
    echo "With --ui, open differing databases in KeepassXC for manual merge."
    exit "${1:-0}"
}

cleanup_after_error() {
    rm -rf "$1"
    exit 1
}

remote_path=
target_dir=
ui_args=

while [[ $# -gt 0 ]]; do
    case "$1" in
        --remote) remote_path="$2"; shift 2 ;;
        --dest)   target_dir="$2"; shift 2 ;;
        --ui)     ui_args="--ui"; shift ;;
        -h|--help) do_usage 0 ;;
        *) echo "Unknown option: $1"; do_usage 1 ;;
    esac
done

if [[ -z "$remote_path" ]]; then
    echo "--remote is required"
    do_usage 1
fi
if [[ -z "$target_dir" ]]; then
    echo "--dest is required"
    do_usage 1
fi

tmp_dir=$(mktemp -d -t "rclone-secrets-XXXXX")

if [[ ! -d "$tmp_dir" ]]; then
    echo "Could not create temp dir"
    exit 1
fi

trap "cleanup_after_error '$tmp_dir'" SIGINT SIGHUP SIGPIPE SIGQUIT SIGTERM

rclone copy \
  --no-check-dest \
  --no-update-modtime \
  --include "*.kdbx" \
  --max-size 10M \
  "$remote_path" "$tmp_dir"

"$script_dir/secrets-merge-keepass" --dest "$target_dir" --src "$tmp_dir" $ui_args

rm -rf "$tmp_dir"
