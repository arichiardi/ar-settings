#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
script_name=$(basename "$script_path")
script_dir=$(dirname "$script_path")

do_usage() {
    echo "Usage:"
    echo "  $script_name --repo-dir <repo_dir> --remote <rclone_remote_path> [--secret-dir <dir>]"
    echo ""
    echo "Upload .kdbx files from the secrets directory to an rclone remote,"
    echo "then commit and push changes to git."
    exit "${1:-0}"
}

repo_dir=
remote_path=
secret_dir="secrets"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --repo-dir) repo_dir="$2"; shift 2 ;;
        --remote)   remote_path="$2"; shift 2 ;;
        --secret-dir) secret_dir="$2"; shift 2 ;;
        -h|--help) do_usage 0 ;;
        *) echo "Unknown option: $1"; do_usage 1 ;;
    esac
done

if [[ -z "$repo_dir" ]]; then
    echo "--repo-dir is required"
    do_usage 1
fi
if [[ -z "$remote_path" ]]; then
    echo "--remote is required"
    do_usage 1
fi

pushd "$repo_dir" > /dev/null

rclone --verbose copy \
  --update \
  --no-update-modtime \
  --include "*.kdbx" \
  "$secret_dir/" "$remote_path"

git add "$secret_dir"
git commit -m "Update secrets $(date --iso-8601=second)"
git push

popd > /dev/null
